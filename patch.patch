--- Fix for client freeze/crash when joining a world ---
--- File: client/src/vk_init.cpp ---
--- Function: vk_draw() ---

Find this block (around the start of vk_draw):

```cpp
  flushUploads(ctx);

  ctx.lastCamPos = camPos;
  uint32_t frame = ctx.currentFrame;
  vkWaitForFences(ctx.device.device, 1, &ctx.inFlight[frame], VK_TRUE,
                  UINT64_MAX);
  vkResetFences(ctx.device.device, 1, &ctx.inFlight[frame]);

  uint32_t imageIndex;
 VkResult acquireResult = vkAcquireNextImageKHR(ctx.device.device, 
    ctx.swapchain.swapchain, UINT64_MAX,
    ctx.imageAvailable[frame], VK_NULL_HANDLE, &imageIndex);
if (acquireResult != VK_SUCCESS && acquireResult != VK_SUBOPTIMAL_KHR)
    return;
```

Replace with:

```cpp
  flushUploads(ctx);

  ctx.lastCamPos = camPos;
  uint32_t frame = ctx.currentFrame;
  vkWaitForFences(ctx.device.device, 1, &ctx.inFlight[frame], VK_TRUE,
                  UINT64_MAX);

  uint32_t imageIndex;
  VkResult acquireResult = vkAcquireNextImageKHR(ctx.device.device,
      ctx.swapchain.swapchain, UINT64_MAX,
      ctx.imageAvailable[frame], VK_NULL_HANDLE, &imageIndex);
  if (acquireResult == VK_ERROR_OUT_OF_DATE_KHR) {
      // Don't reset fence — no work was submitted. Just return and let
      // the resize handler in the main loop recreate the swapchain.
      return;
  }
  if (acquireResult != VK_SUCCESS && acquireResult != VK_SUBOPTIMAL_KHR)
      return;

  // Only reset fence AFTER successful acquire — guarantees we'll submit
  // work this frame to re-signal it.
  vkResetFences(ctx.device.device, 1, &ctx.inFlight[frame]);
```

